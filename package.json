{
  "name": "multi-chatbot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": "11.19.1"
  },
  "scripts": {
    "pretest": "npm run build",
    "test": "vitest run",
    "pretest:acceptance": "npm run build",
    "test:acceptance": "vitest run tests/acceptance",
    "typecheck:infra": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "typecheck": "npm run typecheck:infra && npm run typecheck:web",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "build:infra": "tsc -p tsconfig.json",
    "build:web": "vite build --config vite.config.ts",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build": "npm run build:infra && npm run build:web && npm run build:runtime",
    "synth": "npm run build:infra && npm run build:runtime && cdk synth",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run synth"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1152.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1152.0",
    "@aws-sdk/client-sesv2": "3.1152.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "aws-cdk": "2.1145.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "3.1152.0",
    "@aws-sdk/client-bedrock-runtime": "3.1152.0",
    "@aws-sdk/client-dynamodb": "3.1152.0",
    "@aws-sdk/lib-dynamodb": "3.1152.0",
    "@strands-agents/sdk": "1.21.0",
    "bedrock-agentcore": "0.4.6"
  }
}
